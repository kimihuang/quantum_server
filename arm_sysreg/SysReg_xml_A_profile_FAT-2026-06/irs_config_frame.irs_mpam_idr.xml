        <reg_purpose>
          
    
      <purpose_text>
        <para>IRS MPAM Identification Register. Contains read-only fields with information about the IRS support for MPAM.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
            <reg_group>GICv5 IRS</reg_group>
      </reg_groups>
      
      
        
