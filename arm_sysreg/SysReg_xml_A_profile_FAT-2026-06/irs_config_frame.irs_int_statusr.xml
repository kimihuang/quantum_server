        <reg_purpose>
          
    
      <purpose_text>
        <para>IRS Interrupt Status Register</para>

      </purpose_text>
      <purpose_text>
        <para>Reports whether a write that sets <register_link state="ext" id="ext-irs_int_selr.xml">IRS_INT_SELR</register_link>.S to 1 is complete and selects a valid interrupt.</para>

      </purpose_text>
      <purpose_text>
        <para>Also reports whether the effects of a write to any IRS interrupt configuration register is complete.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
            <reg_group>GICv5 IRS</reg_group>
      </reg_groups>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>IRS_INT_STATUSR is a 32-bit register.</para>
      </attributes_text>

      </reg_attributes>
