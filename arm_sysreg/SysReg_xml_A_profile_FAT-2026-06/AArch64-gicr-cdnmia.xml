      <access_mechanisms>
          


  
    
      <access_permission_text>
        <para>This system instruction is an alias of the SYSL instruction.</para>
      </access_permission_text>





    
        
        <access_mechanism accessor="GICR CDNMIA" type="SystemAccessor">
            <encoding>
            <access_instruction>GICR &lt;Xt&gt;, CDNMIA</access_instruction>
                
                <enc n="op0" v="0b01"/>
                
                <enc n="op1" v="0b000"/>
                
                <enc n="CRn" v="0b1100"/>
                
                <enc n="CRm" v="0b0011"/>
                
                <enc n="op2" v="0b001"/>
            </encoding>
            <access_permission>
                <ps name="GICR" sections="1" secttype="access_permission">
                <pstext>
if !(IsFeatureImplemented(FEAT_GCIE) &amp;&amp; IsFeatureImplemented(FEAT_AA64)) then
    Undefined();
elsif EffectivelyAtEL0InHost() || EffectivelyAtEL0NotInHost() then
    Undefined();
elsif PSTATE.EL == EL1 then
    if EL2Enabled() &amp;&amp; HCR_EL2().IMO == '1' &amp;&amp; IsFeatureImplemented(FEAT_GCIE_LEGACY) &amp;&amp; ICH_VCTLR_EL2().V3 == '1' then
        Undefined();
    elsif EL2Enabled() &amp;&amp; ICH_HFGITR_EL2().GICRCDNMIA == '0' then
        AArch64_SystemAccessTrap(EL2, 0x18);
    else
        X{64}(t) = AArch64_GICR(GICInstrDomain_CD, GICInstr_NMIA);
    end;
elsif PSTATE.EL == EL2 then
    X{64}(t) = AArch64_GICR(GICInstrDomain_CD, GICInstr_NMIA);
elsif PSTATE.EL == EL3 then
    if IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; FGDTState.E0 == '1' then
        AArch64_SystemAccessTrap(EL3, 0x18);
    else
        X{64}(t) = AArch64_GICR(GICInstrDomain_CD, GICInstr_NMIA);
    end;
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>

      </access_mechanisms>

