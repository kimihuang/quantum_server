      <reg_short_name>GICR CDNMIA</reg_short_name>
        
        <reg_long_name>Non-maskable Interrupt Acknowledge in the Current Interrupt Domain</reg_long_name>



      
            <reg_condition otherwise="UNDEFINED">when FEAT_GCIE is implemented and FEAT_AA64 is implemented</reg_condition>
      




          <reg_reset_value></reg_reset_value>

      <reg_mappings>
        




      </reg_mappings>

        <reg_purpose>
          
    
      <purpose_text>
        <para>Acknowledges the HPPI, if it is signaled with Superpriority and SCTLR_ELx.NMI is 1, in the Current Interrupt Domain.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
          <reg_group>System Instructions</reg_group>
      </reg_groups>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>GICR CDNMIA is a 64-bit System instruction.</para>
      </attributes_text>

      </reg_attributes>
