      <reg_short_name>ICH_CONTEXTR_EL2</reg_short_name>
        
        <reg_long_name>Interrupt Controller Virtual Context Register</reg_long_name>



      
            <reg_condition otherwise="UNDEFINED">when FEAT_GCIE is implemented, (EL2 is implemented or EL3 is implemented), and FEAT_AA64 is implemented</reg_condition>
      




          <reg_reset_value></reg_reset_value>

      <reg_mappings>
        




      </reg_mappings>

        <reg_purpose>
          
    
      <purpose_text>
        <para>Selects the current resident VPE.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
            <reg_group>GIC</reg_group>
            <reg_group>GIC Host Interface Control Registers</reg_group>
