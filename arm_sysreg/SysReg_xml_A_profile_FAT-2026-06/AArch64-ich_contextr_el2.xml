                <pstext>
if !(IsFeatureImplemented(FEAT_GCIE) &amp;&amp; (HaveEL(EL2) || HaveEL(EL3)) &amp;&amp; IsFeatureImplemented(FEAT_AA64)) then
    Undefined();
elsif EffectivelyAtEL0InHost() || EffectivelyAtEL0NotInHost() then
    Undefined();
elsif PSTATE.EL == EL1 then
    if IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; EffectiveHCR_EL2_NVx() IN {'xx1'} &amp;&amp; FGDTState.nH == '1' then
