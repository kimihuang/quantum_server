    <field_description order="before"><para>Indicates whether a VPE is currently resident.</para>
<para>If EL2 is not enabled in the Security state identified by SCR_EL3.{NSE,NS}, the Effective value of this field is 0.</para></field_description>
    <field_values impdef="False">
      <field_value_instance>
        <field_value>0b0</field_value>
        <field_value_description>
          <para>No VPE is resident.</para>
        </field_value_description>
      </field_value_instance>
      <field_value_instance>
        <field_value>0b1</field_value>
        <field_value_description>
          <para>A VPE is resident.</para>
        </field_value_description>
      </field_value_instance>
    </field_values>
