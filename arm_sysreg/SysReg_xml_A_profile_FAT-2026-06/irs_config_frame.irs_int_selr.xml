    <field_description order="before"><para>Writing 1 to this field selects an interrupt. The configuration and state of the selected interrupt can be read using <register_link id="irs_config_frame.irs_int_cfgr.xml" state="">IRS_INT_CFGR</register_link> and updated using the following registers:</para>
<list type="unordered">
<listitem><content><register_link id="irs_config_frame.irs_int_cactiver.xml" state="">IRS_INT_CACTIVER</register_link></content>
</listitem><listitem><content><register_link id="irs_config_frame.irs_int_enabler.xml" state="">IRS_INT_ENABLER</register_link></content>
</listitem><listitem><content><register_link id="irs_config_frame.irs_int_hmr.xml" state="">IRS_INT_HMR</register_link></content>
</listitem><listitem><content><register_link id="irs_config_frame.irs_int_iaffidr.xml" state="">IRS_INT_IAFFIDR</register_link></content>
</listitem><listitem><content><register_link id="irs_config_frame.irs_int_pendingr.xml" state="">IRS_INT_PENDINGR</register_link></content>
</listitem><listitem><content><register_link id="irs_config_frame.irs_int_priorityr.xml" state="">IRS_INT_PRIORITYR</register_link></content>
</listitem></list></field_description>
    <field_description order="after"><para>If this field is not set to 1 on a write to this register, updates to any other field in this register has no effect beyond updating the value of that field.</para>
<para>This means that if <register_link id="irs_config_frame.irs_int_statusr.xml" state="">IRS_INT_STATUSR</register_link>.V is updated as a result of a write to another register, <register_link id="irs_config_frame.irs_int_statusr.xml" state="">IRS_INT_STATUSR</register_link>.V reflects whether the interrupt selected when this field was set to 1 is valid.</para></field_description>
    <field_values impdef="False">
      <field_value_instance>
        <field_value>0b0</field_value>
        <field_value_description>
          <para>The write to this register has no effect.</para>
        </field_value_description>
      </field_value_instance>
      <field_value_instance>
        <field_value>0b1</field_value>
        <field_value_description>
          <para>The write to this register selects an interrupt.</para>
        </field_value_description>
      </field_value_instance>
    </field_values>
