<register_page>
  <registers>
  
    <register execution_state="AArch64" is_register="True" is_internal="True" is_stub_entry="False">
      <reg_short_name>VTLBIDOS&lt;n&gt;_EL2</reg_short_name>
        
        <reg_long_name>Virtual TLBI Domain Outer Shareable Registers</reg_long_name>



      
            <reg_condition otherwise="UNDEFINED">when FEAT_TLBID is implemented and FEAT_AA64 is implemented</reg_condition>
          <reg_array>
              <reg_array_start>0</reg_array_start>
              <reg_array_end>3</reg_array_end>
         </reg_array>
      




          <reg_reset_value></reg_reset_value>

      <reg_mappings>
        




      </reg_mappings>

        <reg_purpose>
          
    
      <purpose_text>
        <para>Transform the value of TLBID in TLBI OS operations executed at EL1 before the operation is broadcast.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
            <reg_group>Memory</reg_group>
            <reg_group>Virt</reg_group>
      </reg_groups>
      <reg_configuration>
        
    
      <configuration_text>
        <para>The number of implemented registers, and the number of TD fields depends on the values of <register_link state="AArch64" id="AArch64-tlbididr_el1.xml">TLBIDIDR_EL1</register_link>.{NOS, NVOS} as follows:</para>

      </configuration_text>
      <configuration_text>
        <table><tgroup cols="3"><thead><row><entry>NOS</entry><entry>NVOS</entry><entry>Outcome</entry></row></thead><tbody><row><entry>0</entry><entry>0</entry><entry>None of VTLBIDOS&lt;n&gt;_EL2 are implemented.</entry></row><row><entry>0</entry><entry>&gt; 0</entry><entry>Prohibited.</entry></row><row><entry>&gt; 0</entry><entry>0</entry><entry>1 TD&lt;m&gt; field, in 1 VTLBIDOS&lt;n&gt;_EL2 register.</entry></row><row><entry>&lt;= 8</entry><entry>1</entry><entry>2 TD&lt;m&gt; fields, in 1 VTLBIDOS&lt;n&gt;_EL2 register.</entry></row><row><entry>&lt;= 8</entry><entry>2</entry><entry>4 TD&lt;m&gt; fields, in 1 VTLBIDOS&lt;n&gt;_EL2 register.</entry></row><row><entry>&lt;= 8</entry><entry>3</entry><entry>8 TD&lt;m&gt; fields, in 1 VTLBIDOS&lt;n&gt;_EL2 register.</entry></row><row><entry>&lt;= 8</entry><entry>4</entry><entry>16 TD&lt;m&gt; fields, across 2 VTLBIDOS&lt;n&gt;_EL2 registers.</entry></row><row><entry>&lt;= 8</entry><entry>5</entry><entry>32 TD&lt;m&gt; fields, across 4 VTLBIDOS&lt;n&gt;_EL2 registers.</entry></row><row><entry>&gt; 8</entry><entry>1</entry><entry>2 TD&lt;m&gt; fields, in 1 VTLBIDOS&lt;n&gt;_EL2 register.</entry></row><row><entry>&gt; 8</entry><entry>2</entry><entry>4 TD&lt;m&gt; fields, in 1 VTLBIDOS&lt;n&gt;_EL2 register.</entry></row><row><entry>&gt; 8</entry><entry>3</entry><entry>8 TD&lt;m&gt; fields, across 2 VTLBIDOS&lt;n&gt;_EL2 registers.</entry></row><row><entry>&gt; 8</entry><entry>4</entry><entry>16 TD&lt;m&gt; fields, across 4 VTLBIDOS&lt;n&gt;_EL2 registers.</entry></row></tbody></tgroup></table>

      </configuration_text>
      <configuration_text>
        <para>If EL2 is not implemented, this register is <arm-defined-word>RES0</arm-defined-word> from EL3.</para>
      </configuration_text>

      </reg_configuration>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>VTLBIDOS&lt;n&gt;_EL2 is a 64-bit register.</para>
      </attributes_text>

      </reg_attributes>
      <reg_fieldsets>
        






<fields id="fieldset_0" length="64">
  <fields_condition>When UInt(TLBIDIDR_EL1.NOS) &lt;= 8</fields_condition>
  <text_before_fields/>
  <field id="fieldset_0-63_0" has_partial_fieldset="False" is_linked_to_partial_fieldset="False" is_access_restriction_possible="False" is_variable_length="False" is_constant_value="False" is_partial_field="False" is_conditional_field_name="False">
    <field_name>TD&lt;m&gt;</field_name>
    <field_msb>63</field_msb>
    <field_lsb>0</field_lsb>
    <rel_range>63:0</rel_range>
    <field_description order="before"><para>Virtual to physical TLBID transformation for Outer shareable TLBIs when <register_link state="AArch64" id="AArch64-tlbididr_el1.xml">TLBIDIDR_EL1</register_link>.NOS &lt;= 8.</para>
<para>This 8-bit field indicates which physical TLBI Domain corresponds to the EL1 view of one virtual TLBI Domain for <instruction>TLBI OS</instruction> instructions.</para>
<para>For VTLBIDOS&lt;n&gt;_EL2.TD&lt;m&gt; this field describes the physical TLBI Domain that corresponds to the EL1 view of domain t, where n is t / 8 and m is t mod 8.</para></field_description>
    <field_description order="after">
      <para>Bits of this field above the size shown in <register_link state="AArch64" id="AArch64-tlbididr_el1.xml">TLBIDIDR_EL1</register_link>.NOS are <arm-defined-word>RES0</arm-defined-word>.</para>
    </field_description>
    <field_array_indexes index_variable="m" element_size="8" range_specifier="8m+7:8m">
      <field_array_index>
        <field_array_start>7</field_array_start>
        <field_array_end>0</field_array_end>
      </field_array_index>
    </field_array_indexes>
    <field_resets>
      <field_reset reset_type="Warm">
        <field_reset_standard_text>AU</field_reset_standard_text>
      </field_reset>
    </field_resets>
  </field>
  <text_after_fields/>
</fields>



<fields id="fieldset_1" length="64">
