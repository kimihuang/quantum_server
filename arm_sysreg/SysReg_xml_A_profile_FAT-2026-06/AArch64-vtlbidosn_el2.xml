        <reg_variables>
              <reg_variable variable="n" max="3"/>
        </reg_variables>

      <access_mechanisms>
          






    
        
        <access_mechanism accessor="MRS VTLBIDOS&lt;n&gt;_EL2" type="SystemAccessor">
            <encoding>
                
                <acc_array var="n">
                    <acc_array_range>0-3</acc_array_range>
                </acc_array>
            <access_instruction>MRS &lt;Xt&gt;, VTLBIDOS&lt;n&gt;_EL2</access_instruction>
                
                <enc n="op0" v="0b11"/>
                
                <enc n="op1" v="0b100"/>
                
                <enc n="CRn" v="0b0010"/>
                
                <enc n="CRm" v="0b1001"/>
                
                <enc n="op2" v="0b0:n[1:0]"/>
            </encoding>
            <access_permission>
                <ps name="MRS" sections="1" secttype="access_permission">
                <pstext>
let n:integer = UInt(op2[1:0]);

if !(IsFeatureImplemented(FEAT_TLBID) &amp;&amp; IsFeatureImplemented(FEAT_AA64)) then
    Undefined();
elsif n &gt;= NUM_VTLBID_REGS then
    Undefined();
elsif HaveEL(EL3) &amp;&amp; PSTATE.EL == EL2 &amp;&amp; EL3SDDUndefPriority() &amp;&amp; SCR_EL3().VTLBIDEn == '0' then
    Undefined();
elsif EffectivelyAtEL0InHost() || EffectivelyAtEL0NotInHost() then
    Undefined();
elsif PSTATE.EL == EL1 then
    if EffectiveHCR_EL2_NVx() IN {'1x1'} then
        X{64}(t) = NVMem(0x540 + (8 * n));
    elsif EffectiveHCR_EL2_NVx() IN {'xx1'} then
        AArch64_SystemAccessTrap(EL2, 0x18);
    else
        Undefined();
    end;
elsif PSTATE.EL == EL2 then
    if HaveEL(EL3) &amp;&amp; SCR_EL3().VTLBIDEn == '0' then
        if EL3SDDUndef() then
            Undefined();
        else
            AArch64_SystemAccessTrap(EL3, 0x18);
        end;
    else
        X{64}(t) = VTLBIDOS_EL2(n);
    end;
elsif PSTATE.EL == EL3 then
    if IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; FGDTState.E0 == '1' then
        AArch64_SystemAccessTrap(EL3, 0x18);
    else
        X{64}(t) = VTLBIDOS_EL2(n);
    end;
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>
    
        
        <access_mechanism accessor="MSRregister VTLBIDOS&lt;n&gt;_EL2" type="SystemAccessor">
            <encoding>
                
                <acc_array var="n">
                    <acc_array_range>0-3</acc_array_range>
                </acc_array>
            <access_instruction>MSR VTLBIDOS&lt;n&gt;_EL2, &lt;Xt&gt;</access_instruction>
                
                <enc n="op0" v="0b11"/>
                
                <enc n="op1" v="0b100"/>
                
                <enc n="CRn" v="0b0010"/>
                
                <enc n="CRm" v="0b1001"/>
                
                <enc n="op2" v="0b0:n[1:0]"/>
            </encoding>
            <access_permission>
                <ps name="MSRregister" sections="1" secttype="access_permission">
                <pstext>
let n:integer = UInt(op2[1:0]);

if !(IsFeatureImplemented(FEAT_TLBID) &amp;&amp; IsFeatureImplemented(FEAT_AA64)) then
    Undefined();
elsif n &gt;= NUM_VTLBID_REGS then
    Undefined();
elsif HaveEL(EL3) &amp;&amp; PSTATE.EL == EL2 &amp;&amp; EL3SDDUndefPriority() &amp;&amp; SCR_EL3().VTLBIDEn == '0' then
    Undefined();
elsif EffectivelyAtEL0InHost() || EffectivelyAtEL0NotInHost() then
    Undefined();
elsif PSTATE.EL == EL1 then
    if IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; EffectiveHCR_EL2_NVx() IN {'xx1'} &amp;&amp; FGDTState.nH == '1' then
        AArch64_FGDTSystemAccessTrap(EL1, 0x18);
    elsif EffectiveHCR_EL2_NVx() IN {'1x1'} then
        NVMem(0x540 + (8 * n)) = X{64}(t);
    elsif EffectiveHCR_EL2_NVx() IN {'xx1'} then
        AArch64_SystemAccessTrap(EL2, 0x18);
    else
        Undefined();
    end;
elsif PSTATE.EL == EL2 then
    if IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; FGDTState.nH == '1' then
        AArch64_FGDTSystemAccessTrap(EL2, 0x18);
    elsif HaveEL(EL3) &amp;&amp; SCR_EL3().VTLBIDEn == '0' then
        if EL3SDDUndef() then
            Undefined();
        else
            AArch64_SystemAccessTrap(EL3, 0x18);
        end;
    else
        VTLBIDOS_EL2(n) = X{64}(t);
    end;
elsif PSTATE.EL == EL3 then
    if IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; FGDTState.E0 == '1' then
        AArch64_SystemAccessTrap(EL3, 0x18);
    else
        VTLBIDOS_EL2(n) = X{64}(t);
    end;
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>

      </access_mechanisms>

