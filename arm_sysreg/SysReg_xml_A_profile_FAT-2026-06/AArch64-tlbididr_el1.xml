        <reg_purpose>
          
    
      <purpose_text>
        <para>Provides information on how many bits of the TLBID field are implemented for <instruction>TLBI IS</instruction> and <instruction>TLBI OS</instruction> instructions.</para>
      </purpose_text>

        </reg_purpose>

