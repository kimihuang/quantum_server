    <field_description order="before">
      <para>Number of bits of Virtual TLBI Domain supported for Outer Shareable TLBI instructions.</para>
    </field_description>
    <field_description order="after"><para>The permitted values of this field depend on the value of NOS, as follows:</para>
<list type="unordered">
<listitem><content>
<para>If NOS is 0, NVOS is 0.</para>
</content>
</listitem><listitem><content>
<para>If NOS is between 1 and 8, NVOS is between 1 and 5.</para>
</content>
</listitem><listitem><content>
<para>If NOS is between 9 and 16, NVOS is between 1 and 4.</para>
</content>
</listitem></list></field_description>
    <field_values impdef="True">
      <field_value_instance>
