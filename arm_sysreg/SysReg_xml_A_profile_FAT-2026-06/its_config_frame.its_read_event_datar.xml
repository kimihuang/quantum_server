        <reg_purpose>
          
    
      <purpose_text>
        <para>ITS Read Event Data Register.</para>

      </purpose_text>
      <purpose_text>
        <para>This register is used to return translation information for an EventID and DeviceID specified in <register_link id="its_config_frame.its_eidr.xml" state="">ITS_EIDR</register_link> and <register_link id="its_config_frame.its_didr.xml" state="">ITS_DIDR</register_link> registers, respectively.</para>
      </purpose_text>

        </reg_purpose>

