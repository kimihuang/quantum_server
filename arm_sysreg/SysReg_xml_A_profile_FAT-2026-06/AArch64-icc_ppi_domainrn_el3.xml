      <access_mechanisms>
          






    
        
        <access_mechanism accessor="MRS ICC_PPI_DOMAINR&lt;n&gt;_EL3" type="SystemAccessor">
            <encoding>
                
                <acc_array var="n">
                    <acc_array_range>0-3</acc_array_range>
                </acc_array>
            <access_instruction>MRS &lt;Xt&gt;, ICC_PPI_DOMAINR&lt;n&gt;_EL3</access_instruction>
                
                <enc n="op0" v="0b11"/>
                
                <enc n="op1" v="0b110"/>
                
                <enc n="CRn" v="0b1100"/>
                
                <enc n="CRm" v="0b1000"/>
                
                <enc n="op2" v="0b1:n[1:0]"/>
            </encoding>
            <access_permission>
                <ps name="MRS" sections="1" secttype="access_permission">
                <pstext>
let n:integer = UInt(op2[1:0]);

if !(IsFeatureImplemented(FEAT_GCIE) &amp;&amp; HaveEL(EL3) &amp;&amp; IsFeatureImplemented(FEAT_AA64)) then
    Undefined();
elsif EffectivelyAtEL0InHost() || EffectivelyAtEL0NotInHost() then
    Undefined();
elsif PSTATE.EL == EL1 then
    Undefined();
elsif PSTATE.EL == EL2 then
    Undefined();
elsif PSTATE.EL == EL3 then
    if IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; FGDTState.E0 == '1' then
        AArch64_SystemAccessTrap(EL3, 0x18);
    else
        X{64}(t) = ICC_PPI_DOMAINR_EL3(n);
    end;
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>
    
        
