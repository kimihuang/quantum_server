      <reg_short_name>GIC CDAFF</reg_short_name>
        
        <reg_long_name>Interrupt Set Target in the Current Interrupt Domain</reg_long_name>



      
            <reg_condition otherwise="UNDEFINED">when FEAT_GCIE is implemented and FEAT_AA64 is implemented</reg_condition>
      




          <reg_reset_value></reg_reset_value>

      <reg_mappings>
        




      </reg_mappings>

        <reg_purpose>
          
    
      <purpose_text>
        <para>Sets the routing mode and target PE for the specified INTID in the Current Interrupt Domain.</para>

      </purpose_text>
      <purpose_text>
        <para>If the Current Interrupt Domain is the Virtual Interrupt Domain, this operation applies to the virtual INTID in the VM identified by the resident VPE.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
          <reg_group>System Instructions</reg_group>
      </reg_groups>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>GIC CDAFF is a 64-bit System instruction.</para>
      </attributes_text>

      </reg_attributes>
