      <access_mechanisms>
          


  
    
      <access_permission_text>
        <para>This instruction has no effect if the INTID is unreachable.</para>

      </access_permission_text>
      <access_permission_text>
        <para>This instruction is treated as a NOP if the operation applies to the Virtual Interrupt Domain and there is no resident VPE.</para>

      </access_permission_text>
      <access_permission_text>
        <para>This system instruction is an alias of the SYS instruction.</para>
      </access_permission_text>





    
        
        <access_mechanism accessor="GIC CDAFF" type="SystemAccessor">
            <encoding>
            <access_instruction>GIC CDAFF{, &lt;Xt&gt;}</access_instruction>
                
                <enc n="op0" v="0b01"/>
                
                <enc n="op1" v="0b000"/>
                
                <enc n="CRn" v="0b1100"/>
                
                <enc n="CRm" v="0b0001"/>
                
                <enc n="op2" v="0b011"/>
            </encoding>
            <access_permission>
                <ps name="GIC" sections="1" secttype="access_permission">
                <pstext>
if !(IsFeatureImplemented(FEAT_GCIE) &amp;&amp; IsFeatureImplemented(FEAT_AA64)) then
    Undefined();
elsif EffectivelyAtEL0InHost() || EffectivelyAtEL0NotInHost() then
    Undefined();
elsif PSTATE.EL == EL1 then
    if EL2Enabled() &amp;&amp; HCR_EL2().IMO == '1' &amp;&amp; IsFeatureImplemented(FEAT_GCIE_LEGACY) &amp;&amp; ICH_VCTLR_EL2().V3 == '1' then
        Undefined();
    elsif EL2Enabled() &amp;&amp; ICH_HFGITR_EL2().GICCDAFF == '0' then
        AArch64_SystemAccessTrap(EL2, 0x18);
    else
        AArch64_GIC(X{64}(t), GICInstrDomain_CD, GICInstr_AFF);
    end;
elsif PSTATE.EL == EL2 then
    AArch64_GIC(X{64}(t), GICInstrDomain_CD, GICInstr_AFF);
elsif PSTATE.EL == EL3 then
    if IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; FGDTState.E0 == '1' then
        AArch64_SystemAccessTrap(EL3, 0x18);
    else
        AArch64_GIC(X{64}(t), GICInstrDomain_CD, GICInstr_AFF);
    end;
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>

      </access_mechanisms>

