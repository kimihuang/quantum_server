        <access_mechanism accessor="PLBI PERME3" type="SystemAccessor">
            <encoding>
            <access_instruction>PLBI PERME3{, &lt;Xt&gt;}</access_instruction>
                
                <enc n="op0" v="0b01"/>
                
                <enc n="op1" v="0b110"/>
                
                <enc n="CRn" v="0b1010"/>
                
                <enc n="CRm" v="0b0111"/>
                
                <enc n="op2" v="0b001"/>
            </encoding>
            <access_permission>
                <ps name="PLBI" sections="1" secttype="access_permission">
                <pstext>
if !(IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; IsFeatureImplemented(FEAT_AA64)) then
    Undefined();
elsif EffectivelyAtEL0InHost() || EffectivelyAtEL0NotInHost() then
    Undefined();
elsif PSTATE.EL == EL1 then
    Undefined();
elsif PSTATE.EL == EL2 then
    Undefined();
elsif PSTATE.EL == EL3 then
    if IsFeatureImplemented(FEAT_S1POE2) &amp;&amp; FGDTState.E0 == '1' then
        AArch64_SystemAccessTrap(EL3, 0x18);
    else
        if IsFeatureImplemented(FEAT_RME) &amp;&amp; !ValidSecurityStateAtEL(EL3) then
            return;
        else
            AArch64_PLBI_PERM(SecurityStateAtEL(EL3), Regime_EL3, VMID_NONE, Broadcast_NSH, PLBI_AllAttr, X{64}(t));
        end;
    end;
end;
                </pstext>
                </ps>
            </access_permission>
        </access_mechanism>
    
        
