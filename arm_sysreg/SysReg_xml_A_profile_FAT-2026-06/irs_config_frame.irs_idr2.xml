      </field_value_instance>
      <field_value_instance>
        <field_value>0b1</field_value>
        <field_value_description>
          <para>The IST entries require storage for metadata and the size of a level 2 ISTE is 8 bytes or 16 bytes.</para>
        </field_value_description>
      </field_value_instance>
    </field_values>
