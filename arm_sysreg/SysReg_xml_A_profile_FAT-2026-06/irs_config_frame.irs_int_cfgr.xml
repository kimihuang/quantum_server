        <reg_purpose>
          
    
      <purpose_text>
        <para>Returns the configuration of the interrupt selected in <register_link id="irs_config_frame.irs_int_selr.xml" state="">IRS_INT_SELR</register_link>.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
            <reg_group>GICv5 IRS</reg_group>
      </reg_groups>
      <reg_configuration>
        
    
      <configuration_text>
        <para>This register reports the configuration and state for the interrupt selected by <register_link id="irs_config_frame.irs_int_selr.xml" state="">IRS_INT_SELR</register_link>.</para>

      </configuration_text>
      <configuration_text>
        <para>This register is updated after a write that sets <register_link id="irs_config_frame.irs_int_selr.xml" state="">IRS_INT_SELR</register_link>.S to 1 when <register_link id="irs_config_frame.irs_int_statusr.xml" state="">IRS_INT_STATUSR</register_link>.{V, IDLE} is {1, 1}.</para>

      </configuration_text>
      <configuration_text>
        <para>If there is an update to the interrupt configuration and state following the write that sets <register_link id="irs_config_frame.irs_int_selr.xml" state="">IRS_INT_SELR</register_link>.S to 1, it is <arm-defined-word>IMPLEMENTATION DEFINED</arm-defined-word> whether the old or the new configuration and state is reported in this register.</para>
      </configuration_text>

      </reg_configuration>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>IRS_INT_CFGR is a 64-bit register.</para>
      </attributes_text>

      </reg_attributes>
