<register_block_page>
  <register_blocks>
    <register_block>
      <reg_short_name>GIC_PMU_FRAME</reg_short_name>
        <reg_long_name>GIC PMU register frame</reg_long_name>

        
          <reg_condition>when FEAT_GICv5_EXT is implemented</reg_condition>


      <mappings>
      </mappings>

        <reg_purpose>
          
    
      <purpose_text>
        <para>Contains GIC PMU registers.</para>

      </purpose_text>
      <purpose_text>
        <para>The GIC PMU register frame is accessible in each PAS corresponding to an Interrupt Domain that the PMU can count events for.</para>

      </purpose_text>
      <purpose_text>
        <para>The base address of the GIC PMU register frame is distinct from any other GIC register frame.</para>

      </purpose_text>
      <purpose_text>
        <para>The base address of the GIC PMU register frame is aligned to 64KB.</para>
      </purpose_text>

        </reg_purpose>

      <reg_attributes>
        <attributes_text>
          <para>GIC_PMU_FRAME is a block of size: 64KB</para>
        </attributes_text>
      </reg_attributes>
      <child_blocks default_access="RES0">
                   <child_block>
            <block_offset>0x400 + (8 * n) for n in 63:0</block_offset>
            <block_type>Register</block_type>
            <block_link id="gic_pmu_frame.gic_pmevtypern.xml">GIC_PMEVTYPER&lt;n&gt;</block_link>
            <block_condition>-</block_condition>
            <accessor_condition>-</accessor_condition>
            <block_access>
            <pstext>RW</pstext>
            </block_access>
          </child_block>
                   <child_block>
            <block_offset>0x800 + (8 * n) for n in 63:0</block_offset>
            <block_type>Register</block_type>
            <block_link id="gic_pmu_frame.gic_pmevfilt2rn.xml">GIC_PMEVFILT2R&lt;n&gt;</block_link>
            <block_condition>-</block_condition>
            <accessor_condition>-</accessor_condition>
            <block_access>
            <pstext>RW</pstext>
            </block_access>
          </child_block>
                   <child_block>
            <block_offset>0xA00 + (8 * n) for n in 63:0</block_offset>
            <block_type>Register</block_type>
            <block_link id="gic_pmu_frame.gic_pmevfiltrn.xml">GIC_PMEVFILTR&lt;n&gt;</block_link>
            <block_condition>-</block_condition>
            <accessor_condition>-</accessor_condition>
            <block_access>
            <pstext>RW</pstext>
            </block_access>
          </child_block>
                   <child_block>
            <block_offset>0xD80</block_offset>
            <block_type>Register</block_type>
            <block_link id="gic_pmu_frame.gic_pmidr0.xml">GIC_PMIDR0</block_link>
            <block_condition>-</block_condition>
            <accessor_condition>-</accessor_condition>
            <block_access>
            <pstext>RW</pstext>
            </block_access>
          </child_block>
      </child_blocks>

    </register_block>
  </register_blocks>
