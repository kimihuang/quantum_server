    <field_description order="before">
      <para>Unique vector per TIndex.</para>
    </field_description>
    <field_description order="after">
      <para>If <register_link state="AArch64" id="AArch64-irtbrp_el3.xml">IRTBRP_EL3</register_link>.POE2 == '0', then the Effective value of this field is 0.</para>
    </field_description>
    <field_values impdef="False">
      <field_value_instance>
        <field_value>0b0</field_value>
        <field_value_description>
          <para>The Vector Base Address defined in field VBA of this register is used unchanged. The <instruction>TENTER</instruction> and <instruction>TEXIT</instruction> instructions are <arm-defined-word>UNDEFINED</arm-defined-word> at EL3.</para>
        </field_value_description>
      </field_value_instance>
      <field_value_instance>
        <field_value>0b1</field_value>
        <field_value_description>
          <para>The Vector Base Address defined in field VBA of this register has an offset added. The offset is equal to <register_link state="AArch64" id="AArch64-tindex_el3.xml">TINDEX_EL3</register_link>.TIndex multiplied by the granule size in bytes. The granule size is configured by <register_link state="AArch64" id="AArch64-tcr_el3.xml">TCR_EL3</register_link>.TG0.</para>
        </field_value_description>
      </field_value_instance>
    </field_values>
