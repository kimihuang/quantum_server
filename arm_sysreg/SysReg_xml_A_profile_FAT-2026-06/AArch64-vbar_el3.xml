    <register execution_state="AArch64" is_register="True" is_internal="True" is_stub_entry="False">
      <reg_short_name>VBAR_EL3</reg_short_name>
        
        <reg_long_name>Vector Base Address Register (EL3)</reg_long_name>



      
            <reg_condition otherwise="UNDEFINED">when EL3 is implemented and FEAT_AA64 is implemented</reg_condition>
      




          <reg_reset_value></reg_reset_value>

      <reg_mappings>
        




      </reg_mappings>

        <reg_purpose>
          
    
      <purpose_text>
        <para>Holds the vector base address for any exception that is taken to EL3.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
            <reg_group>Secure</reg_group>
            <reg_group>Exception</reg_group>
      </reg_groups>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>VBAR_EL3 is a 64-bit register.</para>
      </attributes_text>

      </reg_attributes>
      <reg_fieldsets>
        






<fields id="fieldset_0" length="64">
