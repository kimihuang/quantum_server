  <fieldat id="fieldset_0-15_0" msb="15" lsb="0"/>
</reg_fieldset>


      </reg_fieldsets>

      <access_mechanisms>
          


  
    
      <access_permission_text>
        <para>When the value of VIRT in the register is 1, meaning that the selected SPI is assigned to a VM, any write that does not set VIRT to 0 is ignored.</para>

      </access_permission_text>
      <access_permission_text>
        <para>To assign an SPI to a different VM, the SPI must first be unassigned from the old VM, and then subsequently assigned to the new VM.</para>
      </access_permission_text>





    
        
