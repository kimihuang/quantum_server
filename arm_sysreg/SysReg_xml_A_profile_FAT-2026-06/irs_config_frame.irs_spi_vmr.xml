</reg_address>


          <reg_reset_value></reg_reset_value>

      <reg_mappings>
        




      </reg_mappings>

        <reg_purpose>
          
    
      <purpose_text>
        <para>IRS SPI VM Assignment Register.</para>

      </purpose_text>
      <purpose_text>
        <para>Allows software to read and update the VM assignment of the SPI selected by <register_link id="irs_config_frame.irs_spi_selr.xml" state="">IRS_SPI_SELR</register_link>.</para>
      </purpose_text>

        </reg_purpose>

      <reg_groups>
            <reg_group>GICv5 IRS</reg_group>
      </reg_groups>
      <reg_configuration>
        
    
      <configuration_text>
        <para>The effects of a write to this register are not guaranteed to have completed before <register_link id="irs_config_frame.irs_spi_statusr.xml" state="">IRS_SPI_STATUSR</register_link>.IDLE is 1.</para>

      </configuration_text>
      <configuration_text>
        <para>Following a write to this register, <register_link id="irs_config_frame.irs_spi_statusr.xml" state="">IRS_SPI_STATUSR</register_link>.V is updated.</para>
      </configuration_text>

      </reg_configuration>
      
      
        
      <reg_attributes>
          
    
      <attributes_text>
        <para>IRS_SPI_VMR is a 64-bit register.</para>
      </attributes_text>

      </reg_attributes>
      <reg_fieldsets>
        






<fields id="fieldset_0" length="64">
  <text_before_fields>
    <para>This register is updated after a write to <register_link id="irs_config_frame.irs_spi_selr.xml" state="">IRS_SPI_SELR</register_link> when <register_link id="irs_config_frame.irs_spi_statusr.xml" state="">IRS_SPI_STATUSR</register_link>.{V, IDLE} is {1, 1}.</para>
  </text_before_fields>
  <field id="fieldset_0-63_63" has_partial_fieldset="False" is_linked_to_partial_fieldset="False" is_access_restriction_possible="False" is_variable_length="False" is_constant_value="False" is_partial_field="False" is_conditional_field_name="False">
    <field_name>VIRT</field_name>
    <field_msb>63</field_msb>
    <field_lsb>63</field_lsb>
    <rel_range>63</rel_range>
    <field_description order="before">
      <para>Whether the SPI selected by <register_link id="irs_config_frame.irs_spi_selr.xml" state="">IRS_SPI_SELR</register_link> is assigned as a virtual SPI to the VM.</para>
    </field_description>
    <field_values impdef="False">
      <field_value_instance>
        <field_value>0b0</field_value>
        <field_value_description>
          <para>The SPI is not assigned to a VM.</para>
        </field_value_description>
      </field_value_instance>
      <field_value_instance>
        <field_value>0b1</field_value>
        <field_value_description>
          <para>The SPI is assigned to the VM specified by VM_ID.</para>
        </field_value_description>
      </field_value_instance>
    </field_values>
  </field>
  <field id="fieldset_0-62_16" has_partial_fieldset="False" is_linked_to_partial_fieldset="False" is_access_restriction_possible="False" is_variable_length="False" is_constant_value="False" is_partial_field="False" is_conditional_field_name="False" rwtype="RES0">
    <field_msb>62</field_msb>
    <field_lsb>16</field_lsb>
    <rel_range>62:16</rel_range>
    <field_description order="before"/>
    <field_description order="before">
      <para>Reserved, <arm-defined-word>RES0</arm-defined-word>.</para>
    </field_description>
  </field>
  <field id="fieldset_0-15_0" has_partial_fieldset="False" is_linked_to_partial_fieldset="False" is_access_restriction_possible="False" is_variable_length="False" is_constant_value="False" is_partial_field="False" is_conditional_field_name="False">
    <field_name>VM_ID</field_name>
    <field_msb>15</field_msb>
    <field_lsb>0</field_lsb>
    <rel_range>15:0</rel_range>
    <field_description order="before">
      <para>Identifies the VM that the SPI selected by <register_link id="irs_config_frame.irs_spi_selr.xml" state="">IRS_SPI_SELR</register_link> is assigned to.</para>
    </field_description>
    <field_description order="after">
      <para>Following a write to <register_link id="irs_config_frame.irs_spi_selr.xml" state="">IRS_SPI_SELR</register_link>, when IRS_SPI_VMR.VIRT is 0, this field is set to an <arm-defined-word>UNKNOWN</arm-defined-word> value.</para>
    </field_description>
    <field_access>
      <field_access_state>
        <field_access_level>When IRS_SPI_VMR.VIRT == '1'</field_access_level>
        <field_access_type>RO</field_access_type>
      </field_access_state>
      <field_access_state>
        <field_access_type>RW</field_access_type>
      </field_access_state>
    </field_access>
  </field>
  <text_after_fields/>
</fields>




