  <registers>
  
    <register is_register="True" is_internal="False" is_stub_entry="False">
      <reg_short_name>IRS_SPI_VMR</reg_short_name>
        
        <reg_long_name>IRS SPI VM Assignment Register</reg_long_name>


        <reg_parent_link id="irs_config_frame.xml">IRS_CONFIG_FRAME</reg_parent_link>

      
            <reg_condition otherwise="RES0">when FEAT_GICv5_EXT is implemented and IRS_IDR0.VIRT == '1'</reg_condition>
      



    
