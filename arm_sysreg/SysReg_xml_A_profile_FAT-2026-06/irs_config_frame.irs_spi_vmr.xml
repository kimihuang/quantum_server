        external_access="False"
        mem_map_access="False"
        block_access="True"
        memory_access="True"
        table_id="IRS_CONFIG_FRAMEacccessor0"
    >
  
  <reg_frame>IRS_CONFIG_FRAME</reg_frame>
  
    
    <reg_offset><hexnumber>0x0100</hexnumber></reg_offset>
    <reg_access>
    
        
      <reg_access_state>
          <reg_access_level>When IRS_SPI_STATUSR.[V,IDLE] != '11'</reg_access_level>
          <reg_access_type>UNKNOWN/WI</reg_access_type>
      </reg_access_state>
        
      <reg_access_state>
          <reg_access_level>When !IsSPIDVISupported(IRS_SPI_SELR.ID)</reg_access_level>
